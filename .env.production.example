# ==============================================================================
# Huntly Production Environment Configuration Template (.env.production.example)
# Copy this file to your production server/secret manager (e.g. Render, Railway, AWS SSM)
# NEVER commit real production secrets or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Production Core Settings
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-cryptographically-random-50-character-secret-key

# Production must ALWAYS have DEBUG=False
DEBUG=False

# Active Django settings module
DJANGO_SETTINGS_MODULE=huntly.settings.prod

# ------------------------------------------------------------------------------
# 2. Hostnames, Domains & Reverse Proxy
# ------------------------------------------------------------------------------
# Comma-separated list of fully qualified domains serving the application
ALLOWED_HOSTS=huntly.app,www.huntly.app,app.huntly.app

# Trusted HTTPS origins for CSRF protection
CSRF_TRUSTED_ORIGINS=https://huntly.app,https://www.huntly.app,https://app.huntly.app

# SSL Redirect (enforced by default in prod.py)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 3. Production PostgreSQL Database (Neon / AWS RDS / Cloud SQL)
# ------------------------------------------------------------------------------
# Huntly strictly requires PostgreSQL in production. SQLite is forbidden in prod.py.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://huntly_app_user:REPLACE_WITH_STRONG_DB_PASSWORD@ep-huntly-prod.us-east-2.aws.neon.tech/huntly_production?sslmode=require

# Database connection pooling timeout (seconds)
CONN_MAX_AGE=600
DB_SSL_REQUIRE=True

# ------------------------------------------------------------------------------
# 4. Storage & Static Assets (Neon Object Storage / S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
# Assets bucket for candidate resume documents and private attachments
S3_BUCKET=huntly-prod-assets
AWS_ENDPOINT_URL_S3=https://your-neon-or-r2-endpoint.storage.neon.tech
AWS_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 5. Billing & Payment Gateway (Paystack / Stripe)
# ------------------------------------------------------------------------------
# Supported providers: "paystack", "stripe", or "mock" (for sandbox verification)
HUNTLY_PAYMENT_PROVIDER=paystack

# Paystack API Keys (Primary gateway for African and multi-currency billing)
PAYSTACK_PUBLIC_KEY=replace-with-your-paystack-public-key
PAYSTACK_SECRET_KEY=replace-with-your-paystack-secret-key

# Stripe API Keys (International card payments)
STRIPE_PUBLISHABLE_KEY=replace-with-your-stripe-publishable-key
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret

# ------------------------------------------------------------------------------
# 6. Production Email & Recruiter Outreach (Transactional SMTP / Resend / SendGrid)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=REPLACE_WITH_SENDGRID_OR_POSTMARK_API_KEY
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Huntly <notifications@huntly.app>

# ------------------------------------------------------------------------------
# 7. AI Tailoring Engine & LLM Gateway
# ------------------------------------------------------------------------------
# Frontier model provider API keys.
# Huntly's service layer automatically falls back to deterministic extraction if unavailable.
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_GEMINI_API_KEY
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
