# ==============================================================================
# Huntly Production Environment Configuration (.env)
# ==============================================================================

# Django Core
# Generate a secure 50+ character random string for production
SECRET_KEY=django-insecure-replace-this-with-a-50-character-random-secret-key-in-prod
DEBUG=False
DJANGO_SETTINGS_MODULE=huntly.settings.prod

# Networking & Security
# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=huntly.app,www.huntly.app,.onrender.com,localhost,127.0.0.1

# Comma-separated list of trusted HTTPS origins for CSRF protection
CSRF_TRUSTED_ORIGINS=https://huntly.app,https://www.huntly.app,https://huntly.onrender.com

# Enforce HTTPS redirect (set to False only behind a reverse proxy terminating SSL)
SECURE_SSL_REDIRECT=True

# Database (PostgreSQL recommended in production, SQLite supported)
# Neon, Supabase, Render, Railway, AWS RDS, or local SQLite:
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/huntly

# AI Tailoring Engine
# Provide either Gemini or OpenAI API key for live LLM tailoring
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# Email / Recruiter Outreach Settings (Optional default SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Huntly <noreply@huntly.app>
