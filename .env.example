# ==============================================================================
# Huntly Environment Configuration Template (.env.example)
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
# In production, generate a secure random key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-this-with-a-50-character-secret-key

# Set DEBUG=True for local development; DEBUG=False for production
DEBUG=True

# Select settings module:
# - huntly.settings.dev (for local development with debug logging)
# - huntly.settings.prod (for production with WhiteNoise, SSL, and security headers)
DJANGO_SETTINGS_MODULE=huntly.settings.dev

# ------------------------------------------------------------------------------
# 2. Hostnames & Networking
# ------------------------------------------------------------------------------
# Comma-separated list of domain names the Django application can serve
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,huntly.app,www.huntly.app,.onrender.com

# Comma-separated list of trusted HTTPS origins for CSRF verification (Django 4+)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://huntly.app,https://www.huntly.app

# Enforce HTTPS redirect (Set to False for local dev or behind an SSL-terminating reverse proxy)
SECURE_SSL_REDIRECT=False

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL & SQLite)
# ------------------------------------------------------------------------------
# Huntly supports both 'postgres://' and 'postgresql://' URL schemes via psycopg / psycopg2.
# Query parameters such as ?sslmode=require and poolers are automatically parsed.
# Examples:
#   Neon:      postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/huntly?sslmode=require
#   Supabase:  postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
#   Render:    postgresql://huntly:password@dpg-xxxx.render.com/huntly_db
#   Local PG:  postgresql://postgres:password@localhost:5432/huntly
#   SQLite:    sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# ------------------------------------------------------------------------------
# 4. AI Tailoring Engine (LLM API Keys)
# ------------------------------------------------------------------------------
# Huntly uses Gemini (gemini-2.5-flash) or OpenAI (gpt-4o-mini) to match resumes
# against job descriptions. If keys are omitted, Huntly falls back to its deterministic engine.
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# 5. Email & Recruiter Outreach (SMTP)
# ------------------------------------------------------------------------------
# Email backend:
#   - django.core.mail.backends.console.EmailBackend (prints to console - great for dev)
#   - django.core.mail.backends.smtp.EmailBackend (sends real emails via SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Huntly <noreply@huntly.app>

# ------------------------------------------------------------------------------
# 6. Credential Rotation & Secret Management Procedure
# ------------------------------------------------------------------------------
#
# A. SECRET_KEY ROTATION:
#    Huntly uses SECRET_KEY to derive AES-128-CBC + HMAC-SHA256 (Fernet) keys for encrypting
#    sensitive user credentials at rest (e.g. SMTP passwords in AppSetting).
#    If SECRET_KEY must be rotated:
#    1. Run a one-time migration script that reads existing AppSetting.get_decrypted_email_password()
#       under OLD_SECRET_KEY, re-encrypts using NEW_SECRET_KEY, and saves to database.
#    2. Update SECRET_KEY in your hosting dashboard (e.g. Render, Railway, AWS).
#    3. Redeploy or restart the application server. All active user sessions will be invalidated safely.
#
# B. DATABASE_URL ROTATION:
#    1. Create a new database role/password in Neon / PostgreSQL.
#    2. Update DATABASE_URL in your hosting provider environment variables.
#    3. Restart web dynos / containers. Verify connection with `python manage.py check --database default`.
#    4. Revoke the old PostgreSQL role credentials once traffic cutover is verified.
#
# C. AI PROVIDER API KEYS (Gemini / OpenAI):
#    1. Generate a new API key in Google AI Studio or OpenAI developer console.
#    2. Set GEMINI_API_KEY / OPENAI_API_KEY in production environment settings.
#    3. Huntly dynamically picks up the new key on process restart. Revoke old key in provider dashboard.
#
# D. NEON OBJECT STORAGE S3 CREDENTIALS (Optional):
#    AWS_ENDPOINT_URL_S3=https://...
#    AWS_ACCESS_KEY_ID=your-key-id
#    AWS_SECRET_ACCESS_KEY=your-secret-access-key
#    S3_BUCKET=assets

